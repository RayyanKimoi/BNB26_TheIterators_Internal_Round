# Black Box - environment template. Copy to .env and fill in. Never commit .env

# --- Supabase / Postgres ---
SUPABASE_URL=https://your-project-ref.supabase.co
# New-style API keys (Supabase dashboard > Project Settings > API Keys)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Legacy JWT keys, still accepted
SUPABASE_ANON_KEY=your-supabase-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-jwt
# Direct Postgres connection used by SQLModel
# Settings > Database > Connection string > URI
DATABASE_URL=postgresql+psycopg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- LLM layer (explanations and suggested fixes only) ---
# The ML model owns localization. The LLM never picks the flagged step
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Model ---
MODEL_PATH=model/artifacts/localizer.joblib
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Below this, predicted_class returns "unknown" instead of guessing
CONFIDENCE_THRESHOLD=0.5

# --- Diagnosis engine providers (optional) ---
# The local hybrid engine is the default and the fallback. Every variable
# below is opt-in: unset means that provider is unavailable and diagnosis
# silently uses the local engine, which is what the Model tab benchmarks.
#
# Groq runs the same LLM-as-judge prompt the Model tab measures at 32.5% on
# held-out classes, against the hybrid engine's 52.5%. Selecting it makes
# diagnosis worse, not better; it exists for provider flexibility.
GROQ_API_KEY=gsk_your-groq-key
# Model availability differs per key. A 404 means your key cannot use that
# model: list yours with
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
# LLM inference is slower than a scoring webhook, so it gets its own budget.
GROQ_TIMEOUT_S=20
#
# Remote scoring services. These are read server-side on purpose: a caller
# cannot supply a URL, because POSTing an internal trace to a client-named
# endpoint would be server-side request forgery.
# ENGINE_CUSTOM_LLM_URL=https://llm.internal/diagnose
# ENGINE_WEBHOOK_URL=https://scoring.internal/diagnose
# ENGINE_AIR_GAPPED_URL=http://localhost:11434/diagnose

# --- Alerts (P1) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# --- App ---
# Where the backend listens. Informational here: the frontend reads its own
# VITE_API_BASE_URL (Vite only exposes VITE_-prefixed vars to the browser),
# and defaults to http://localhost:8000 when that is unset.
API_BASE_URL=http://localhost:8000

# Where the DASHBOARD is served. backend/alerts.py builds the Slack deep link
# as {DASHBOARD_BASE_URL}/trace/{run_id}, and GET /settings reports it.
# Defaults to http://localhost:5173. Set this in any deployed environment or
# every alert will link people at their own laptop.
DASHBOARD_BASE_URL=http://localhost:5173
